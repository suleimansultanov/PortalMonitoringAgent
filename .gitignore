node_modules/
.next/
out/
build/
.DS_Store

.env
.env.local
.env*.local
# `.env*.local` requires the name to END in .local, so a dated backup of
# .env.local — which scripts/use-database.sh writes before replacing it — slips
# past it and would be committed by `git add -A`, connection string and all.
.env.local.*
.env.*.backup

*.tsbuildinfo
next-env.d.ts

.vercel

# Saved portal pages used as parser fixtures are committed on purpose —
# see src/lib/portals/__fixtures__/. Anything else scraped is not.
#
# `.pages/` is the local stand-in for S3: every page the collector fetched, kept
# so parsers can be re-run without asking the portal again. One commune is
# 131 MB and the whole gulf is about a gigabyte, so it must never reach git —
# and beyond size, it is a mirror of somebody else's copyrighted listings and
# their agencies' photography. Fine to hold on a working machine for re-parsing;
# not something to publish in a repository.
.pages/
/tmp/
*.tmp.ts

# Database dumps. Same reasoning as `.pages/` above: this is a copy of other
# people's listings and their agencies' text, and the repository is public.
# `git add -A` after a sync would otherwise commit 19 MB of it.
pma-data.sql
*.sql.backup
backup-*.sql

# Nightly run logs. Useful on the machine that collects, meaningless anywhere
# else, and they name portals and URLs — the same reasoning as `.pages/`.
# `logs/latest` is a symlink into today's directory.
logs/
